{
  "name": "Comping",
  "private": true,
  "scripts": {
    "install:all": "pnpm install --recursive",
    "dev:api": "pnpm --filter api dev",
    "dev:ui": "pnpm --filter ui dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:ui\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
